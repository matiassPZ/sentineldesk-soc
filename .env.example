# Configuración de Entorno para SentinelDesk (Plantilla de Producción)
# Configura estas variables en el panel de Render / Railway

# 1. Base de Datos Relacional PostgreSQL (Neon.tech)
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# 2. Clave secreta para tokens JWT (RBAC & Auth)
JWT_SECRET="genera_una_clave_aleatoria_segura_para_produccion"

# 3. Puerto HTTP (Asignado dinámicamente por la plataforma cloud)
PORT=3000

# 4. Entorno de Ejecución
NODE_ENV="production"
